{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Gateway": {
    "DashboardOrigins": [
      "http://localhost:3000"
    ],
    "WidgetPath": "../../../apps/widget/dist",
    "RateLimits": {
      "AuthPerMinute": 20,
      "ChatPerMinute": 30
    }
  },
  "ReverseProxy": {
    "Routes": {
      "auth": {
        "ClusterId": "identity",
        "CorsPolicy": "dashboard",
        "RateLimiterPolicy": "auth",
        "Match": {
          "Path": "/api/auth/{**rest}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          }
        ]
      },
      "bots": {
        "ClusterId": "bots",
        "CorsPolicy": "dashboard",
        "Match": {
          "Path": "/api/bots/{**rest}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          }
        ]
      },
      "chat": {
        "ClusterId": "chat",
        "CorsPolicy": "public",
        "RateLimiterPolicy": "chat",
        "Match": {
          "Path": "/api/chat/{**rest}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          }
        ]
      },
      "account": {
        "ClusterId": "bots",
        "CorsPolicy": "dashboard",
        "Match": {
          "Path": "/api/account/{**rest}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          }
        ]
      },
      "billing": {
        "ClusterId": "bots",
        "Match": {
          "Path": "/api/billing/{**rest}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          }
        ]
      },
      "admin-tenants": {
        "ClusterId": "identity",
        "CorsPolicy": "dashboard",
        "RateLimiterPolicy": "auth",
        "Match": {
          "Path": "/api/admin/tenants"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          }
        ]
      },
      "admin-subscriptions": {
        "ClusterId": "bots",
        "CorsPolicy": "dashboard",
        "RateLimiterPolicy": "auth",
        "Match": {
          "Path": "/api/admin/subscriptions/{**rest}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          }
        ]
      },
      "channels": {
        "ClusterId": "chat",
        "Match": {
          "Path": "/api/channels/{**rest}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          }
        ]
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5120/"
          }
        }
      },
      "bots": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5215/"
          }
        }
      },
      "chat": {
        "HttpRequest": {
          "ActivityTimeout": "00:02:00"
        },
        "Destinations": {
          "d1": {
            "Address": "http://localhost:8000/"
          }
        }
      }
    }
  }
}