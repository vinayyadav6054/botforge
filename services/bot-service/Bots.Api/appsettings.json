{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "botforge-identity",
    "Audience": "botforge"
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "User": "botforge",
    "Exchange": "botforge.events"
  },
  "Storage": { "RootPath": "../../../storage" }
}