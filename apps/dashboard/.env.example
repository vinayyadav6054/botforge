# public URL of the API gateway (the browser calls it directly)
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# public website (all optional)
# WhatsApp number for "Talk on WhatsApp" buttons: country code + number, no "+" or spaces
NEXT_PUBLIC_CONTACT_WHATSAPP=
NEXT_PUBLIC_CONTACT_EMAIL=
# public key (bk_...) of a real bot built from public/samples/sunrise-academy.txt; empty = scripted demo on /demo
NEXT_PUBLIC_DEMO_BOT_KEY=
